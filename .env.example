# Copy to .env (never commit .env). Every value has a safe default for development.

# --- Backend (Khải) ---
WW_ENV=dev
WW_DATABASE_URL=sqlite:///./walletwarden.db
WW_JWT_SECRET=change-me-to-a-long-random-string
WW_JWT_EXPIRE_MINUTES=1440
WW_FRONTEND_DIST=../frontend/dist

# --- AI module (Vi) ---
# Provider chain, tried left to right. The rules engine is always the last resort.
#   fake          -> simulated AI, no GPU or key needed (default for development)
#   local         -> llama.cpp llama-server on 127.0.0.1:8080
#   gemini        -> Gemini API (needs WW_GEMINI_API_KEY)
WW_AI_PROVIDERS=fake
WW_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
WW_LLAMA_MODEL=walletwarden-local
WW_LLAMA_TIMEOUT_S=25
WW_LLAMA_MAX_CONCURRENCY=4
WW_GEMINI_API_KEY=
WW_GEMINI_MODEL=gemini-2.5-flash
WW_GEMINI_TIMEOUT_S=20
WW_AI_RATE_LIMIT_PER_MINUTE=10
WW_AI_LOG_FILE=../logs/ai_calls.jsonl
